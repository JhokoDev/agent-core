# Template: adapte User e caminhos antes de instalar.
[Unit]
Description=Personal Agent API - phase 0
After=network.target ollama.service

[Service]
Type=simple
User=personal-agent
WorkingDirectory=/opt/personal-agent
ExecStart=/opt/personal-agent/.venv/bin/personal-agent serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/personal-agent/data

[Install]
WantedBy=multi-user.target
